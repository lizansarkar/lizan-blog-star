# Database (PostgreSQL - Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth v5 Secret (generate with: openssl rand -base64 32 or any 32-char secret)
AUTH_SECRET="lizan-blog-star-secure-jwt-secret-key-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini AI (for Ask Lizan AI Reader Assistant)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=""

# Optional Services:
# Cloudinary (for writer desk image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (for newsletter and transactional emails)
RESEND_API_KEY=""
